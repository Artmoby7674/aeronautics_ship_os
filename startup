-- ArtCorpOS - Startup
-- Setup wizard: connect peripherals one at a time, auto-detect and assign

local version = "1.0"
local configDir = "config"
local libDir = "lib"

-- ============================================================
-- Helpers
-- ============================================================

local function scanNetwork()
    local found = {}
    local modem = peripheral.find("modem", function(name, m)
        return not m.isWireless()
    end)
    if modem then
        local names = modem.getNamesRemote()
        for _, name in ipairs(names) do
            local devType = modem.getTypeRemote(name)
            table.insert(found, { name = name, type = devType, via = "wired" })
        end
    end
    local wireless = peripheral.find("modem", function(name, m)
        return m.isWireless()
    end)
    if wireless then
        for _, ptype in ipairs({"monitor", "speaker"}) do
            local dev = peripheral.find(ptype)
            if dev then
                local wname = peripheral.getName(dev)
                if wname then
                    local already = false
                    for _, f in ipairs(found) do
                        if f.name == wname then already = true break end
                    end
                    if not already then
                        table.insert(found, { name = wname, type = ptype, via = "wireless" })
                    end
                end
            end
        end
    end
    return found
end

local function diffDevices(before, after)
    local before_names = {}
    for _, d in ipairs(before) do before_names[d.name] = true end
    local new = {}
    for _, d in ipairs(after) do
        if not before_names[d.name] then
            table.insert(new, d)
        end
    end
    return new
end

local function waitForNewDevice(before)
    while true do
        os.pullEvent("key")
        local after = scanNetwork()
        local new = diffDevices(before, after)
        if #new > 0 then
            return new[1]
        end
        print("  No new device detected. Make sure the modem is")
        print("  placed adjacent to the computer and right-clicked.")
        print("  Press any key to try again.")
    end
end

local function promptContinue(msg)
    print(msg)
    print("  Press any key when ready...")
    os.pullEvent("key")
end

-- ============================================================
-- Boot
-- ============================================================

term.clear()
term.setCursorPos(1, 1)

if term.isColor() then
    term.setTextColor(colors.blue)
end
print("========================================")
print("        ARTCORPOS v" .. version)
print("   Flight Stabilization System")
print("========================================")
if term.isColor() then
    term.setTextColor(colors.white)
end
print("")

-- ============================================================
-- Step 0: Disconnect all modems
-- ============================================================

print("[0/4] Prepare peripherals")
print("  Disconnect ALL modems from the computer.")
print("  This ensures a clean scan for the setup wizard.")
print("  You will reconnect them one at a time later.")
print("")
promptContinue("  When all modems are removed, press any key.")

-- ============================================================
-- Step 1: Load config
-- ============================================================

print("[1/5] Loading configuration...")

local configs = {}
local configFiles = fs.list(configDir)
for _, file in ipairs(configFiles) do
    if file:match("%.lua$") and not file:match("^assignments_") then
        table.insert(configs, (file:gsub("%.lua$", "")))
    end
end

if #configs == 0 then
    print("  ERROR: No config files found in " .. configDir .. "/")
    return
end

local selected_config = nil
if #configs == 1 then
    selected_config = configs[1]
    print("  Found config: " .. selected_config)
else
    print("  Available configs:")
    for i, name in ipairs(configs) do
        print("    " .. i .. ") " .. name)
    end
    write("  Select config (1-" .. #configs .. "): ")
    local choice = read()
    local idx = tonumber(choice)
    if idx and idx >= 1 and idx <= #configs then
        selected_config = configs[idx]
    else
        print("  Invalid selection.")
        return
    end
end

local config_path = configDir .. "." .. selected_config
local ok, config = pcall(require, config_path)
if not ok then
    print("  ERROR: Failed to load config: " .. tostring(config))
    return
end
print("  Config loaded: " .. config.name .. " v" .. (config.version or "unknown"))
print("")

-- ============================================================
-- Step 2: Load hardware library
-- ============================================================

print("[2/5] Loading hardware library...")
local Hardware = require(libDir .. ".hardware")
Hardware.init(config)
print("  Hardware library loaded")
print("")

-- ============================================================
-- Step 3: Setup wizard
-- ============================================================

-- Check for saved assignments
local assignments_file = configDir .. "/assignments_" .. selected_config .. ".lua"
local assignments = {}
local has_saved = false
if fs.exists(assignments_file) then
    local aok, asaved = pcall(function()
        local fn = loadfile(assignments_file)
        if fn then return fn() end
    end)
    if aok and asaved and type(asaved) == "table" then
        assignments = asaved
        has_saved = true
    end
end

if has_saved then
    print("[3/5] Using saved peripheral assignments")
    for key, name in pairs(assignments) do
        print("  " .. key .. " -> " .. name)
    end
    print("")
else
    print("[3/5] Peripheral setup wizard")
    print("  This will guide you through connecting each peripheral.")
    print("  Connect one device at a time when prompted.")
    print("")

    -- Build list of required peripherals from config
    local required = {}
    for key, name in pairs(config.peripherals) do
        if name and name ~= "" then
            local desc = ""
            if key == "input_1" then desc = "Typewriter relay for WASD keys"
            elseif key == "input_2" then desc = "Typewriter relay for Q/E keys"
            elseif key == "output_FL" then desc = "Front-left propeller relay"
            elseif key == "output_FR" then desc = "Front-right propeller relay"
            elseif key == "output_RL" then desc = "Rear-left propeller relay"
            elseif key == "output_RR" then desc = "Rear-right propeller relay"
            elseif key == "output_REAR" then desc = "Rear thruster relay"
            elseif key == "main_monitor" then desc = "HUD display monitor"
            elseif key == "speaker" then desc = "Audio speaker"
            else desc = key
            end
            table.insert(required, { key = key, target = name, desc = desc })
        end
    end

    -- Sort: inputs first, then outputs, then optional
    local order = { input_1 = 1, input_2 = 2, output_FL = 3, output_FR = 4,
                    output_RL = 5, output_RR = 6, output_REAR = 7,
                    main_monitor = 8, speaker = 9 }
    table.sort(required, function(a, b)
        return (order[a.key] or 99) < (order[b.key] or 99)
    end)

    -- Scan baseline
    print("  Scanning current network...")
    local baseline = scanNetwork()
    print("  Found " .. #baseline .. " device(s) already connected.")
    print("")

    for i, req in ipairs(required) do
        print("  [" .. i .. "/" .. #required .. "] Connect: " .. req.desc)
        print("            Target name: " .. req.target)
        print("")
        promptContinue("  Connect the device's modem to the network cable, then right-click it.")

        local new_dev = waitForNewDevice(baseline)
        assignments[req.key] = new_dev.name
        print("  -> Detected: " .. new_dev.name .. " (" .. new_dev.type .. ")")
        print("  -> Assigned: " .. req.key)
        print("")

        -- Update baseline so next scan doesn't re-detect this one
        table.insert(baseline, new_dev)
    end

    -- Save assignments
    local save_fn = io.open(assignments_file, "w")
    if save_fn then
        save_fn:write("return {\n")
        for key, name in pairs(assignments) do
            save_fn:write('  [' .. string.format("%q", key) .. '] = ' .. string.format("%q", name) .. ',\n')
        end
        save_fn:write("}\n")
        save_fn:close()
        print("  Assignments saved to " .. assignments_file)
    end
end

-- Apply assignments to config
for key, name in pairs(assignments) do
    config.peripherals[key] = name
end

print("")

-- ============================================================
-- Step 4: Connect to peripherals
-- ============================================================

print("[4/5] Connecting to peripherals...")
local connected, missing = Hardware.connect()

if #missing > 0 then
    print("")
    print("  MISSING peripherals:")
    for _, name in ipairs(missing) do
        print("    - " .. name)
    end
    print("  These functions will not be available.")
    print("  Re-run setup to connect them.")
end

print("")
print("[5/5] Ready!")
print("")
print("========================================")
if #missing > 0 then
    print("  WARNING: " .. #missing .. " peripheral(s) missing")
else
    print("  All peripherals connected")
end
print("  Press any key to start the OS...")
print("========================================")
os.pullEvent("key")

-- ============================================================
-- Launch main OS
-- ============================================================

term.clear()
term.setCursorPos(1, 1)
print("Starting ArtCorpOS...")
print("")

if not package.path:match("lib/%?%.lua") then
    package.path = "lib/?.lua;" .. package.path
end

local os_main = require(libDir .. ".os_main")
os_main.start(config, Hardware)
