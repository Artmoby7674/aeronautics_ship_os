-- Check for saved assignments
local assignments_file = configDir .. "/assignments_" .. selected_config .. ".lua"
local assignments = {}
local has_saved = false
if fs.exists(assignments_file) then
    local aok, asaved = pcall(function()
        local fn = loadfile(assignments_file)
        if fn then return fn() end
    end)
    if aok and asaved and type(asaved) == "table" then
        assignments = asaved
        has_saved = true
    end
end

if has_saved then
    print("[3/5] Using saved peripheral assignments")
    for key, name in pairs(assignments) do
        print("  " .. key .. " -> " .. name)
    end
    print("")
else
    print("[3/5] Peripheral setup wizard")
    print("  This will guide you through connecting each peripheral.")
    print("  Connect one device at a time when prompted.")
    print("")

    -- Build list of required peripherals from config
    local required = {}
    for key, name in pairs(config.peripherals) do
        if name and name ~= "" then
            local desc = ""
            if key == "input_1" then desc = "Typewriter relay for WASD keys"
            elseif key == "input_2" then desc = "Typewriter relay for Q/E keys"
            elseif key == "output_FL" then desc = "Front-left propeller relay"
            elseif key == "output_FR" then desc = "Front-right propeller relay"
            elseif key == "output_RL" then desc = "Rear-left propeller relay"
            elseif key == "output_RR" then desc = "Rear-right propeller relay"
            elseif key == "output_REAR" then desc = "Rear thruster relay"
            elseif key == "main_monitor" then desc = "HUD display monitor"
            elseif key == "speaker" then desc = "Audio speaker"
            else desc = key
            end
            table.insert(required, { key = key, target = name, desc = desc })
        end
    end

    -- Sort: inputs first, then outputs, then optional
    local order = { input_1 = 1, input_2 = 2, output_FL = 3, output_FR = 4,
                    output_RL = 5, output_RR = 6, output_REAR = 7,
                    main_monitor = 8, speaker = 9 }
    table.sort(required, function(a, b)
        return (order[a.key] or 99) < (order[b.key] or 99)
    end)

    -- Scan baseline
    print("  Scanning current network...")
    local baseline = scanNetwork()
    print("  Found " .. #baseline .. " device(s) already connected.")
    print("")

    for i, req in ipairs(required) do
        print("  [" .. i .. "/" .. #required .. "] Connect: " .. req.desc)
        print("            Target name: " .. req.target)
        print("")
        promptContinue("  Connect the device's modem to the network cable, then right-click it.")

        local new_dev = waitForNewDevice(baseline)
        assignments[req.key] = new_dev.name
        print("  -> Detected: " .. new_dev.name .. " (" .. new_dev.type .. ")")
        print("  -> Assigned: " .. req.key)
        print("")

        -- Update baseline so next scan doesn't re-detect this one
        table.insert(baseline, new_dev)
    end

    -- Save assignments
    local save_fn = io.open(assignments_file, "w")
    if save_fn then
        save_fn:write("return {\n")
        for key, name in pairs(assignments) do
            save_fn:write('  [' .. string.format("%q", key) .. '] = ' .. string.format("%q", name) .. ',\n')
        end
        save_fn:write("}\n")
        save_fn:close()
        print("  Assignments saved to " .. assignments_file)
    end
end

-- Apply assignments to config
for key, name in pairs(assignments) do
    config.peripherals[key] = name
end

-- Assign optional peripherals that are missing (e.g. aux_relay)
local function saveAssignments()
    local save_fn = io.open(assignments_file, "w")
    if not save_fn then return false end
    save_fn:write("return {\n")
    for key, name in pairs(assignments) do
        save_fn:write('  [' .. string.format("%q", key) .. '] = ' .. string.format("%q", name) .. ',\n')
    end
    save_fn:write("}\n")
    save_fn:close()
    return true
end

local optional = config.optional_peripherals or {}
if #optional > 0 then
    local baseline = scanNetwork()
    local any_new = false
    for _, key in ipairs(optional) do
        local current = assignments[key]
        local wrapped = current and peripheral.wrap(current)
        if not wrapped then
            any_new = true
            print("[3b] Optional peripheral: " .. key)
            print("  Connect this device's modem, then right-click it.")
            print("  Press any key when ready...")
            os.pullEvent("key")
            local new_dev = waitForNewDevice(baseline)
            assignments[key] = new_dev.name
            config.peripherals[key] = new_dev.name
            table.insert(baseline, new_dev)
            print("  -> Assigned: " .. key .. " = " .. new_dev.name)
            print("")
        end
    end
    if any_new and saveAssignments() then
        print("  Assignments updated: " .. assignments_file)
        print("")
    end
end

