local function scanNetwork()
    local found = {}
    local modem = peripheral.find("modem", function(name, m)
        return not m.isWireless()
    end)
    if modem then
        local names = modem.getNamesRemote()
        for _, name in ipairs(names) do
            local devType = modem.getTypeRemote(name)
            table.insert(found, { name = name, type = devType, via = "wired" })
        end
    end
    local wireless = peripheral.find("modem", function(name, m)
        return m.isWireless()
    end)
    if wireless then
        for _, ptype in ipairs({"monitor", "speaker"}) do
            local dev = peripheral.find(ptype)
            if dev then
                local wname = peripheral.getName(dev)
                if wname then
                    local already = false
                    for _, f in ipairs(found) do
                        if f.name == wname then already = true break end
                    end
                    if not already then
                        table.insert(found, { name = wname, type = ptype, via = "wireless" })
                    end
                end
            end
        end
    end
    return found
end

local function diffDevices(before, after)
    local before_names = {}
    for _, d in ipairs(before) do before_names[d.name] = true end
    local new = {}
    for _, d in ipairs(after) do
        if not before_names[d.name] then
            table.insert(new, d)
        end
    end
    return new
end

local function waitForNewDevice(before)
    while true do
        os.pullEvent("key")
        local after = scanNetwork()
        local new = diffDevices(before, after)
        if #new > 0 then
            return new[1]
        end
        print("  No new device detected. Make sure the modem is")
        print("  placed adjacent to the computer and right-clicked.")
        print("  Press any key to try again.")
    end
end

local function promptContinue(msg)
    print(msg)
    print("  Press any key when ready...")
    os.pullEvent("key")
end

