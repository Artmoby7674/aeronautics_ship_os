-- ArtCorpOS - Startup
-- Runs on computer boot, guides user through peripheral naming

local version = "1.0"
local configDir = "config"
local libDir = "lib"

-- ============================================================
-- Boot sequence
-- ============================================================

term.clear()
term.setCursorPos(1, 1)

print("========================================")
print("      ARTCORPOS v" .. version)
print("   Flight Stabilization System")
print("========================================")
print("")
print("Initializing...")
print("")

-- ============================================================
-- Step 1: Load config
-- ============================================================

print("[1/4] Loading configuration...")

local configs = {}
local configFiles = fs.list(configDir)
for _, file in ipairs(configFiles) do
    if file:match("%.lua$") and not file:match("^assignments_") then
        table.insert(configs, (file:gsub("%.lua$", "")))
    end
end

if #configs == 0 then
    print("  ERROR: No config files found in " .. configDir .. "/")
    return
end

local selected_config = nil
if #configs == 1 then
    selected_config = configs[1]
    print("  Found config: " .. selected_config)
else
    print("  Available configs:")
    for i, name in ipairs(configs) do
        print("    " .. i .. ") " .. name)
    end
    write("  Select config (1-" .. #configs .. "): ")
    local choice = read()
    local idx = tonumber(choice)
    if idx and idx >= 1 and idx <= #configs then
        selected_config = configs[idx]
    else
        print("  Invalid selection.")
        return
    end
end

local config_path = configDir .. "." .. selected_config
local ok, config = pcall(require, config_path)
if not ok then
    print("  ERROR: Failed to load config: " .. tostring(config))
    return
end
print("  Config loaded: " .. config.name .. " v" .. (config.version or "unknown"))
print("")

-- ============================================================
-- Step 2: Load hardware library
-- ============================================================

print("[2/4] Loading hardware library...")
local Hardware = require(libDir .. ".hardware")
Hardware.init(config)
print("  Hardware library loaded")
print("")

-- ============================================================
-- Step 3: Peripheral naming guide
-- ============================================================

print("[3/4] Peripheral setup")
print("  The following peripherals are required.")
print("  Use the 'rename' command to name each one.")
print("")
print("  In the CC terminal, type:")
print("    rename <peripheral_name> <required_name>")
print("")
print("  Example: rename modem_0 wired_modem")
print("")

-- Build list of required peripherals from config
local required = {}
for key, name in pairs(config.peripherals) do
    if name and name ~= "" then
        local desc = key
        if key == "input_1" then desc = "input_1 - Typewriter relay (WASD)"
        elseif key == "input_2" then desc = "input_2 - Typewriter relay (Q/E)"
        elseif key == "output_FL" then desc = "output_FL - Front-left propeller"
        elseif key == "output_FR" then desc = "output_FR - Front-right propeller"
        elseif key == "output_RL" then desc = "output_RL - Rear-left propeller"
        elseif key == "output_RR" then desc = "output_RR - Rear-right propeller"
        elseif key == "output_REAR" then desc = "output_REAR - Rear thrusters"
        elseif key == "main_monitor" then desc = "main_monitor - HUD display"
        elseif key == "speaker" then desc = "speaker - Audio alerts"
        end
        table.insert(required, { key = key, name = name, desc = desc })
    end
end

table.sort(required, function(a, b) return a.key < b.key end)

print("  Required peripherals:")
print("  ----------------------------------------")
for _, r in ipairs(required) do
    print("    rename <source> " .. r.name)
    print("      -> " .. r.desc)
end
print("  ----------------------------------------")
print("")

-- Scan network to show available devices
print("  Scanning network for available devices...")
local found, err = Hardware.scan()
if found then
    print("  Found " .. #found .. " devices:")
    for _, dev in ipairs(found) do
        local via = dev.via and (" [" .. dev.via .. "]") or ""
        print("    " .. dev.name .. " (" .. dev.type .. ")" .. via)
    end
else
    print("  WARNING: " .. tostring(err))
end
print("")

print("  Rename your devices now, then press any key to continue.")
print("  (You can skip devices you don't have - they'll be reported as missing)")
print("")
os.pullEvent("key")

-- ============================================================
-- Step 4: Connect to peripherals
-- ============================================================

print("[4/4] Connecting to peripherals...")
local connected, missing = Hardware.connect()

if #missing > 0 then
    print("")
    print("  MISSING peripherals:")
    for _, name in ipairs(missing) do
        print("    - " .. name)
    end
    print("  These functions will not be available.")
    print("  You can rename them later and restart the OS.")
end

print("")
print("========================================")
print("  Setup complete!")
if #missing > 0 then
    print("  WARNING: " .. #missing .. " peripheral(s) missing")
else
    print("  All peripherals connected")
end
print("  Press any key to start the OS...")
print("========================================")
os.pullEvent("key")

-- ============================================================
-- Launch main OS
-- ============================================================

term.clear()
term.setCursorPos(1, 1)
print("Starting ArtCorpOS...")
print("")

if not package.path:match("lib/%?%.lua") then
    package.path = "lib/?.lua;" .. package.path
end

local os_main = require(libDir .. ".os_main")
os_main.start(config, Hardware)
